<!DOCTYPE html>
<html>

<head>
    <title>Student List</title>
</head>

<body>

    <h1>Student Details</h1>

    <ul>
        <% students.forEach(function(student) { %>
            <li>
                Name: <%= student.name %>, Course: <%= student.course %>
            </li>
            <% }); %>
    </ul>

</body>

</html>